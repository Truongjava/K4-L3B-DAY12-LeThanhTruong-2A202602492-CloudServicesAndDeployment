# File này quyết định thứ KHÔNG được copy vào image (build context).
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secrets — tuyệt đối không vào image
.env
*.pem
*.key

# Git & editor
.git
.gitignore
.idea/
.vscode/
.DS_Store

# Python cache & môi trường ảo
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
*.egg-info/

# Tài liệu & dữ liệu không cần cho runtime
*.log
screenshots/
solution/